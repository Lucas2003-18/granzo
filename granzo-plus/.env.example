# Copie para .env (chmod 600). NUNCA commitar valores reais, nem colar no vault/chat.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_ID=

DISCORD_TOKEN=
DISCORD_OWNER_ID=
DISCORD_GUILD_ID=
CHANNEL_DIARIO_ID=
CHANNEL_MENSAL_ID=
CHANNEL_ALERTAS_ID=
CHANNEL_STATUS_ID=

# Chave do SQLCipher: de preferência via Docker secret (arquivo) em vez de variável.
DB_KEY_FILE=/run/secrets/granzo_db_key
DB_PATH=/data/granzo-plus.db

# Opcional: categorização por LLM (só a descrição do estabelecimento é enviada)
GEMINI_API_KEY=

TZ=America/Sao_Paulo
DAILY_HOUR=7
DAILY_MINUTE=30
# Enviar mensagem curta quando não houver movimentação nova?
DAILY_SEND_WHEN_EMPTY=true
