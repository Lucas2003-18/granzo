# Token do bot Discord (Discord Developer Portal → Bot → Token)
DISCORD_TOKEN=

# ID do aplicativo Discord (Developer Portal → General Information → Application ID)
DISCORD_CLIENT_ID=

# ID do servidor Discord onde os slash commands serão registrados
# (clique direito no servidor → Copiar ID, com modo desenvolvedor ativado)
DISCORD_GUILD_ID=

# ID do canal onde o bot envia notificações proativas
DISCORD_CHANNEL_ID=

# Chave de autenticação entre o app Granzo e este backend (crie qualquer string segura)
GRANZO_API_KEY=minha-chave-secreta

# Porta do servidor Express
PORT=3000
